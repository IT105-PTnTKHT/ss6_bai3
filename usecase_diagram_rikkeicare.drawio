<mxfile host="app.diagrams.net">
  <diagram id="usecase" name="Use Case Diagram - RikkeiCare">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1000" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System boundary -->
        <mxCell id="boundary" value="He thong RikkeiCare" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="580" height="600" as="geometry" />
        </mxCell>

        <!-- Actor -->
        <mxCell id="actor" value="Benh nhan" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="60" height="90" as="geometry" />
        </mxCell>

        <!-- Use cases -->
        <mxCell id="ucLogin" value="Dang nhap" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="320" y="90" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ucBook" value="Dat lich kham" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="330" y="290" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ucThuong" value="Dat lich kham thuong" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="600" y="230" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ucUuTien" value="Dat lich kham uu tien\n(phu phi)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="600" y="340" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ucChonBS" value="Chon bac si chi dinh" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="320" y="470" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Associations -->
        <mxCell id="a1" style="html=1;endArrow=none;" edge="1" parent="1" source="actor" target="ucLogin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="html=1;endArrow=none;" edge="1" parent="1" source="actor" target="ucBook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Include: Dat lich kham ..> Dang nhap -->
        <mxCell id="inc1" value="&lt;&lt;include&gt;&gt;" style="html=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="ucBook" target="ucLogin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Extend: Chon bac si chi dinh ..> Dat lich kham -->
        <mxCell id="ext1" value="&lt;&lt;extend&gt;&gt;" style="html=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="ucChonBS" target="ucBook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Generalization: ucThuong -> ucBook, ucUuTien -> ucBook -->
        <mxCell id="gen1" style="html=1;endArrow=block;endFill=0;endSize=16;" edge="1" parent="1" source="ucThuong" target="ucBook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gen2" style="html=1;endArrow=block;endFill=0;endSize=16;" edge="1" parent="1" source="ucUuTien" target="ucBook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
